{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aihero.dev/sop-schema/review-report.schema.json",
  "title": "审查报告",
  "description": "T1 审查 Team 输出的缺陷审查与去重报告，作为 T2 调查 Team 的输入。",
  "type": "object",
  "required": [
    "schema_version", "artifact_id", "run_id", "trace_id",
    "producer", "status", "started_at", "completed_at", "duration_ms",
    "input_refs", "evidence_refs", "validation", "next_action", "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "artifact_id": {
      "type": "string",
      "description": "本产物唯一 ID，建议格式 art_review_report_{uuid}",
      "pattern": "^art_review_report_[a-z0-9_]+$"
    },
    "run_id": {
      "type": "string",
      "description": "本次闭环执行唯一 ID",
      "pattern": "^run_[a-z0-9_]+$"
    },
    "trace_id": {
      "type": "string",
      "description": "分布式追踪 ID（32 位 hex）",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parent_artifact_id": {
      "type": ["string", "null"],
      "description": "上游产物引用；首产物为 null"
    },
    "producer": {
      "type": "object",
      "required": ["team", "agent", "model"],
      "additionalProperties": false,
      "properties": {
        "team": { "type": "string", "enum": ["review"] },
        "agent": { "type": "string", "enum": ["review-leader"] },
        "model": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["passed", "rejected", "inconclusive", "failed"],
      "description": "本阶段结果。passed / rejected 可进入下一阶段；inconclusive 需补充信息；failed 需人工介入"
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref_id", "type", "uri"],
        "additionalProperties": false,
        "properties": {
          "ref_id": { "type": "string" },
          "type": { "type": "string", "enum": ["issue", "ticket", "log", "user_feedback", "codebase", "artifact"] },
          "uri": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "type", "uri", "description"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": { "type": "string" },
          "type": { "type": "string", "enum": ["log", "diff", "test_report", "coverage", "trace", "screenshot", "other"] },
          "uri": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "description": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["schema", "valid"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "string", "const": "review-report.schema.json" },
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "keyword": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "enum": ["investigate", "review", "human_review", "done"] },
        "reason_code": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["canonical_defects", "merged_defects", "rejected_defects", "t2_readiness"],
      "additionalProperties": false,
      "properties": {
        "canonical_defects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "canonical_defect_id", "title", "description", "severity", "priority",
              "affected_versions", "affected_components", "source_refs",
              "dedup_decisions", "observed_symptoms", "investigation_scope"
            ],
            "additionalProperties": false,
            "properties": {
              "canonical_defect_id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
              "priority": { "type": "string", "enum": ["p0", "p1", "p2", "p3"] },
              "affected_versions": { "type": "array", "items": { "type": "string" } },
              "affected_components": { "type": "array", "items": { "type": "string" } },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["source", "source_id"],
                  "additionalProperties": false,
                  "properties": {
                    "source": { "type": "string", "enum": ["issue", "ticket", "log", "user_feedback"] },
                    "source_id": { "type": "string" },
                    "url": { "type": "string" }
                  }
                }
              },
              "dedup_decisions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["compared_defect", "verdict", "evidence"],
                  "additionalProperties": false,
                  "properties": {
                    "compared_defect": {
                      "type": "object",
                      "required": ["source", "source_id"],
                      "additionalProperties": false,
                      "properties": {
                        "source": { "type": "string" },
                        "source_id": { "type": "string" }
                      }
                    },
                    "verdict": { "type": "string", "enum": ["same", "related", "different", "inconclusive"] },
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string" }
                    },
                    "dedup_key": { "type": "string" }
                  }
                }
              },
              "reproduction_clues": { "type": "array", "items": { "type": "string" } },
              "observed_symptoms": { "type": "array", "items": { "type": "string" } },
              "stack_fingerprint": { "type": "string" },
              "missing_information": { "type": "array", "items": { "type": "string" } },
              "investigation_scope": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "merged_defects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["canonical_id", "merged_source_ids"],
            "additionalProperties": false,
            "properties": {
              "canonical_id": { "type": "string" },
              "merged_source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "rejected_defects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "reason"],
            "additionalProperties": false,
            "properties": {
              "source_id": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "information_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["defect_id", "gap"],
            "additionalProperties": false,
            "properties": {
              "defect_id": { "type": "string" },
              "gap": { "type": "string" },
              "required_sources": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "t2_readiness": {
          "type": "object",
          "required": ["ready"],
          "additionalProperties": false,
          "properties": {
            "ready": { "type": "boolean" },
            "blockers": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
