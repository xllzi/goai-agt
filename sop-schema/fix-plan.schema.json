{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aihero.dev/sop-schema/fix-plan.schema.json",
  "title": "修复方案",
  "description": "T2 调查 Team 输出的根因调查报告与修复方案，作为 T3 修复 Team 的输入。",
  "type": "object",
  "required": [
    "schema_version", "artifact_id", "run_id", "trace_id", "parent_artifact_id",
    "producer", "status", "started_at", "completed_at", "duration_ms",
    "input_refs", "evidence_refs", "validation", "next_action", "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "artifact_id": {
      "type": "string",
      "pattern": "^art_fix_plan_[a-z0-9_]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[a-z0-9_]+$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parent_artifact_id": { "type": "string" },
    "producer": {
      "type": "object",
      "required": ["team", "agent", "model"],
      "additionalProperties": false,
      "properties": {
        "team": { "type": "string", "enum": ["investigate"] },
        "agent": { "type": "string", "enum": ["investigate-leader"] },
        "model": { "type": "string" }
      }
    },
    "status": { "type": "string", "enum": ["passed", "rejected", "inconclusive", "failed"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref_id", "type", "uri"],
        "additionalProperties": false,
        "properties": {
          "ref_id": { "type": "string" },
          "type": { "type": "string", "enum": ["issue", "ticket", "log", "user_feedback", "codebase", "artifact"] },
          "uri": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "type", "uri", "description"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": { "type": "string" },
          "type": { "type": "string", "enum": ["log", "diff", "test_report", "coverage", "trace", "screenshot", "other"] },
          "uri": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "description": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["schema", "valid"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "string", "const": "fix-plan.schema.json" },
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "keyword": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "enum": ["fix", "investigate", "review", "human_review", "done"] },
        "reason_code": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["target_defect_id", "reproduction", "hypotheses", "root_cause", "fix_candidates"],
      "additionalProperties": false,
      "properties": {
        "target_defect_id": { "type": "string" },
        "reproduction": {
          "type": "object",
          "required": ["environment", "steps", "expected", "actual"],
          "additionalProperties": false,
          "properties": {
            "environment": { "type": "string" },
            "preconditions": { "type": "array", "items": { "type": "string" } },
            "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "expected": { "type": "string" },
            "actual": { "type": "string" }
          }
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "hypothesis_id", "perspective", "assertion",
              "supporting_evidence", "counter_evidence", "result"
            ],
            "additionalProperties": false,
            "properties": {
              "hypothesis_id": { "type": "string" },
              "perspective": {
                "type": "string",
                "enum": ["recent_change", "config", "data", "dependency", "timing", "other"]
              },
              "assertion": { "type": "string" },
              "supporting_evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["evidence_id", "claim"],
                  "additionalProperties": false,
                  "properties": {
                    "evidence_id": { "type": "string" },
                    "type": { "type": "string", "enum": ["code", "log", "config", "metric", "trace", "other"] },
                    "uri": { "type": "string" },
                    "location": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "start_line": { "type": "integer" },
                        "end_line": { "type": "integer" }
                      }
                    },
                    "claim": { "type": "string" },
                    "verification": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "method": { "type": "string" },
                        "result": { "type": "string", "enum": ["confirmed", "refuted", "inconclusive"] }
                      }
                    }
                  }
                }
              },
              "counter_evidence": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "experiments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["description", "outcome"],
                  "additionalProperties": false,
                  "properties": {
                    "description": { "type": "string" },
                    "outcome": { "type": "string", "enum": ["confirmed", "refuted", "inconclusive"] }
                  }
                }
              },
              "result": { "type": "string", "enum": ["confirmed", "rejected", "inconclusive"] }
            }
          }
        },
        "root_cause": {
          "type": "object",
          "required": ["conclusion", "causal_chain", "confidence"],
          "additionalProperties": false,
          "properties": {
            "conclusion": { "type": "string" },
            "causal_chain": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "evidence_refs": {
              "type": "array",
              "items": { "type": "string" }
            },
            "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
            "unresolved_questions": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "fix_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["candidate_id", "approach", "impact_scope", "risks", "rollback_strategy", "acceptance_criteria"],
            "additionalProperties": false,
            "properties": {
              "candidate_id": { "type": "string" },
              "approach": { "type": "string" },
              "target_files": { "type": "array", "items": { "type": "string" } },
              "expected_changes": { "type": "array", "items": { "type": "string" } },
              "impact_scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "risks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "rollback_strategy": { "type": "string" },
              "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "priority": { "type": "string", "enum": ["p0", "p1", "p2", "p3"] }
            }
          }
        },
        "selected_candidate_id": { "type": "string" }
      }
    }
  }
}
