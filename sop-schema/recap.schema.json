{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aihero.dev/sop-schema/recap.schema.json",
  "title": "复盘知识条目",
  "description": "独立复盘 Agent 输出的可检索、可回灌的知识条目，沉淀修复全过程经验。",
  "type": "object",
  "required": [
    "schema_version", "artifact_id", "run_id", "trace_id", "parent_artifact_id",
    "producer", "status", "started_at", "completed_at", "duration_ms",
    "input_refs", "evidence_refs", "validation", "next_action", "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "artifact_id": {
      "type": "string",
      "pattern": "^art_recap_[a-z0-9_]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[a-z0-9_]+$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "parent_artifact_id": { "type": "string" },
    "producer": {
      "type": "object",
      "required": ["team", "agent", "model"],
      "additionalProperties": false,
      "properties": {
        "team": { "type": "string", "enum": ["standalone"] },
        "agent": { "type": "string", "enum": ["recapper"] },
        "model": { "type": "string" }
      }
    },
    "status": { "type": "string", "enum": ["passed", "rejected", "inconclusive", "failed"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref_id", "type", "uri"],
        "additionalProperties": false,
        "properties": {
          "ref_id": { "type": "string" },
          "type": { "type": "string", "enum": ["issue", "ticket", "log", "user_feedback", "codebase", "artifact"] },
          "uri": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "type", "uri", "description"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": { "type": "string" },
          "type": { "type": "string", "enum": ["log", "diff", "test_report", "coverage", "trace", "screenshot", "other"] },
          "uri": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "description": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["schema", "valid"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "string", "const": "recap.schema.json" },
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "keyword": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "enum": ["done", "human_review"] },
        "reason_code": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "defect_id", "defect_summary", "root_cause_pattern",
        "resolution_summary", "regression_lesson", "new_regression_tests", "reusable_rules"
      ],
      "additionalProperties": false,
      "properties": {
        "defect_id": { "type": "string" },
        "defect_summary": { "type": "string" },
        "root_cause_pattern": { "type": "string" },
        "trigger_conditions": { "type": "array", "items": { "type": "string" } },
        "resolution_summary": { "type": "string" },
        "effective_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidence_id", "why_effective"],
            "additionalProperties": false,
            "properties": {
              "evidence_id": { "type": "string" },
              "why_effective": { "type": "string" }
            }
          }
        },
        "misleading_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["signal", "why_misleading"],
            "additionalProperties": false,
            "properties": {
              "signal": { "type": "string" },
              "why_misleading": { "type": "string" }
            }
          }
        },
        "failed_hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hypothesis", "why_failed"],
            "additionalProperties": false,
            "properties": {
              "hypothesis": { "type": "string" },
              "why_failed": { "type": "string" }
            }
          }
        },
        "failed_fix_attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["attempt", "why_failed"],
            "additionalProperties": false,
            "properties": {
              "attempt": { "type": "string" },
              "why_failed": { "type": "string" }
            }
          }
        },
        "regression_lesson": { "type": "string" },
        "new_regression_tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["test_name", "type", "covers"],
            "additionalProperties": false,
            "properties": {
              "test_name": { "type": "string" },
              "type": { "type": "string", "enum": ["unit", "integration", "e2e", "property"] },
              "covers": { "type": "string" },
              "location": { "type": "string" }
            }
          }
        },
        "reusable_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["target", "rule", "rationale"],
            "additionalProperties": false,
            "properties": {
              "target": { "type": "string", "enum": ["T1", "T2", "T3"] },
              "rule": { "type": "string" },
              "rationale": { "type": "string" },
              "source_refs": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "knowledge_tags": { "type": "array", "items": { "type": "string" } },
        "related_defects": { "type": "array", "items": { "type": "string" } },
        "follow_up_actions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
