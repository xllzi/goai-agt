 // Get 根据 key 返回缓存条目。若 key 不存在或条目已过期，返回 false。
 // 此方法是并发安全的。
 func (s *Store) Get(key string) (Item, bool) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
 	item, ok := s.items[key]
 	if !ok {
 		return Item{}, false
 	}
 	if time.Now().After(item.ExpiresAt) {
+		// 过期条目不在 Get 中清理，由 Refresh 负责
